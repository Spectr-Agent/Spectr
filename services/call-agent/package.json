{
  "name": "@spectr/call-agent",
  "private": true,
  "type": "module",
  "description": "Spectr voice agent for phone calls (LiveKit SIP), FaceTime (Chert) and in-app calls",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local src/main.ts dev",
    "start": "tsx --env-file-if-exists=.env.local src/main.ts start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@livekit/agents": "1.10.0",
    "@livekit/agents-plugin-livekit": "1.10.0",
    "@livekit/agents-plugin-silero": "1.10.0",
    "@livekit/rtc-node": "1.2.2",
    "livekit-server-sdk": "2.19.3",
    "postgres": "~3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
