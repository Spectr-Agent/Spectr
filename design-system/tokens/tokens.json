{
  "$description": "Spectr design tokens (W3C DTCG format). Colors are split by theme: color.light and color.dark.",
  "color": {
    "light": {
      "surface-100": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Page background."
      },
      "surface-200": {
        "$type": "color",
        "$value": "#F4F4F6",
        "$description": "Cards and sheets sitting on surface-100."
      },
      "surface-300": {
        "$type": "color",
        "$value": "#E8E8EC",
        "$description": "Sunken areas, inputs and the live viewer well."
      },
      "ink": {
        "$type": "color",
        "$value": "#17171B",
        "$description": "Primary text on surface-100 and surface-200."
      },
      "ink-muted": {
        "$type": "color",
        "$value": "#55555F",
        "$description": "Secondary text and captions on surface-100 and surface-200."
      },
      "border": {
        "$type": "color",
        "$value": "#DADADF",
        "$description": "Hairlines and card outlines."
      },
      "inverse": {
        "$type": "color",
        "$value": "#17171B",
        "$description": "Primary buttons and the push to talk pill. Black in light mode, white in dark mode."
      },
      "on-inverse": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Text and icons on inverse."
      },
      "clay": {
        "$type": "color",
        "$value": "#DAEAFA",
        "$description": "The mascot body color. Use for large soft fields, never for text."
      },
      "sky": {
        "$type": "color",
        "$value": "#9CCBF0",
        "$description": "The one accent. Selected states, the active chip and small highlights. Use sparingly: most of a screen stays black, white and grey."
      },
      "on-fill": {
        "$type": "color",
        "$value": "#17171B",
        "$description": "Text and icons on sky and clay."
      },
      "brand-text": {
        "$type": "color",
        "$value": "#2F6FB0",
        "$description": "Links and accent colored text on surface-100 and surface-200."
      },
      "slab": {
        "$type": "color",
        "$value": "#17171B",
        "$description": "Dark identity block in covers and hero art. Lifts to charcoal in dark mode."
      },
      "focus": {
        "$type": "color",
        "$value": "#17171B",
        "$description": "Focus ring, 2px, on every interactive element."
      }
    },
    "dark": {
      "surface-100": {
        "$type": "color",
        "$value": "#0B0B0E",
        "$description": "Page background."
      },
      "surface-200": {
        "$type": "color",
        "$value": "#17171B",
        "$description": "Cards and sheets sitting on surface-100."
      },
      "surface-300": {
        "$type": "color",
        "$value": "#232328",
        "$description": "Sunken areas, inputs and the live viewer well."
      },
      "ink": {
        "$type": "color",
        "$value": "#F5F5F7",
        "$description": "Primary text on surface-100 and surface-200."
      },
      "ink-muted": {
        "$type": "color",
        "$value": "#A6A6B0",
        "$description": "Secondary text and captions on surface-100 and surface-200."
      },
      "border": {
        "$type": "color",
        "$value": "#34343B",
        "$description": "Hairlines and card outlines."
      },
      "inverse": {
        "$type": "color",
        "$value": "#F5F5F7",
        "$description": "Primary buttons and the push to talk pill. Black in light mode, white in dark mode."
      },
      "on-inverse": {
        "$type": "color",
        "$value": "#17171B",
        "$description": "Text and icons on inverse."
      },
      "clay": {
        "$type": "color",
        "$value": "#DAEAFA",
        "$description": "The mascot body color. Use for large soft fields, never for text."
      },
      "sky": {
        "$type": "color",
        "$value": "#9CCBF0",
        "$description": "The one accent. Selected states, the active chip and small highlights. Use sparingly: most of a screen stays black, white and grey."
      },
      "on-fill": {
        "$type": "color",
        "$value": "#17171B",
        "$description": "Text and icons on sky and clay."
      },
      "brand-text": {
        "$type": "color",
        "$value": "#7DB8EE",
        "$description": "Links and accent colored text on surface-100 and surface-200."
      },
      "slab": {
        "$type": "color",
        "$value": "#2B2B33",
        "$description": "Dark identity block in covers and hero art. Lifts to charcoal in dark mode."
      },
      "focus": {
        "$type": "color",
        "$value": "#F5F5F7",
        "$description": "Focus ring, 2px, on every interactive element."
      }
    }
  },
  "spacing": {
    "space-1": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Icon to label gap."
    },
    "space-2": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Tight stacks, chip padding."
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Control padding."
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Card padding on phones."
    },
    "space-5": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Card padding, section gaps."
    },
    "space-6": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Between groups."
    },
    "space-7": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Screen top and bottom."
    },
    "space-8": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "Hero spacing."
    }
  },
  "radius": {
    "radius-sm": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Chips and small controls."
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Buttons and inputs."
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Cards and sheets."
    },
    "radius-pill": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Pills and the push to talk button."
    }
  },
  "shadow": {
    "light": {
      "shadow-clay": {
        "$type": "shadow",
        "$value": "0 2px 0 rgba(23,23,27,0.05), 0 10px 24px rgba(23,23,27,0.10)",
        "$description": "Cards, soft and puffy like the mascot."
      },
      "shadow-press": {
        "$type": "shadow",
        "$value": "inset 0 2px 4px rgba(23,23,27,0.18)",
        "$description": "Pressed buttons."
      }
    },
    "dark": {
      "shadow-clay": {
        "$type": "shadow",
        "$value": "0 2px 0 rgba(0,0,0,0.30), 0 10px 24px rgba(0,0,0,0.40)",
        "$description": "Cards, soft and puffy like the mascot."
      },
      "shadow-press": {
        "$type": "shadow",
        "$value": "inset 0 2px 4px rgba(0,0,0,0.5)",
        "$description": "Pressed buttons."
      }
    }
  },
  "fontFamily": {
    "display": {
      "$type": "fontFamily",
      "$value": "\"Outfit\", \"Avenir Next\", system-ui, sans-serif"
    },
    "sans": {
      "$type": "fontFamily",
      "$value": "\"Inter\", system-ui, sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "\"JetBrains Mono\", ui-monospace, monospace"
    }
  },
  "typography": {
    "display-xl": {
      "$type": "typography",
      "$description": "Welcome screen and covers.",
      "$value": {
        "fontFamily": "{fontFamily.display}",
        "fontSize": "56px",
        "lineHeight": "56px",
        "fontWeight": 700,
        "letterSpacing": "-0.02em"
      }
    },
    "display-lg": {
      "$type": "typography",
      "$description": "Screen titles.",
      "$value": {
        "fontFamily": "{fontFamily.display}",
        "fontSize": "40px",
        "lineHeight": "44px",
        "fontWeight": 700,
        "letterSpacing": "-0.015em"
      }
    },
    "display-md": {
      "$type": "typography",
      "$description": "Card headlines.",
      "$value": {
        "fontFamily": "{fontFamily.display}",
        "fontSize": "28px",
        "lineHeight": "32px",
        "fontWeight": 600
      }
    },
    "title": {
      "$type": "typography",
      "$description": "List and row titles.",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 600
      }
    },
    "body": {
      "$type": "typography",
      "$description": "Default text.",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "15px",
        "lineHeight": "22px",
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$description": "Buttons and chips.",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 600
      }
    },
    "caption": {
      "$type": "typography",
      "$description": "Hints and timestamps.",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "13px",
        "lineHeight": "18px",
        "fontWeight": 400
      }
    },
    "code": {
      "$type": "typography",
      "$description": "Receipts, pairing codes and transcript.",
      "$value": {
        "fontFamily": "{fontFamily.mono}",
        "fontSize": "13px",
        "lineHeight": "20px",
        "fontWeight": 400
      }
    }
  }
}