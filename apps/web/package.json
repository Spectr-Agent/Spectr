{
  "name": "@spectr/web",
  "version": "0.0.0",
  "private": true,
  "description": "Spectr landing page",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run check:copy && npm run check:style",
    "start": "next start",
    "check:copy": "node scripts/check-copy.mjs",
    "check:style": "node scripts/check-style.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
